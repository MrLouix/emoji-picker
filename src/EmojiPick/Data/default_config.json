{
  "app": {
    "version": "1.0.0",
    "autoStart": true,
    "minimizeToTray": true
  },
  "hotkey": {
    "modifiers": ["Ctrl", "Alt"],
    "key": "E"
  },
  "ui": {
    "theme": "system",
    "fontSize": 24,
    "windowOpacity": 0.97,
    "gridColumns": 7,
    "gridRows": 4,
    "positionMode": "caret",
    "colorEmoji": true,
    "skinTone": 0
  },
  "behavior": {
    "autoClose": true,
    "injectMode": "paste",
    "restoreClipboard": true,
    "fuzzyThreshold": 0.6,
    "maxResults": 42
  },
  "llm": {
    "enabled": true,
    "provider": "auto",
    "fallbackChain": ["ollama", "llamacpp", "fuzzy"],
    "cacheResults": true,
    "cacheTtlMinutes": 5,
    "providers": {
      "ollama": {
        "enabled": true,
        "endpoint": "http://localhost:11434",
        "model": "mistral",
        "timeoutMs": 3000
      },
      "llamacpp": {
        "enabled": true,
        "modelPath": "%APPDATA%/EmojiPick/models/Mistral-7B-Q4_K_M.gguf",
        "useGpu": true,
        "gpuType": "auto",
        "gpuLayers": 20,
        "contextSize": 512,
        "batchSize": 64,
        "timeoutMs": 3000
      }
    }
  },
  "logging": {
    "level": "info",
    "maxFileSizeMb": 10,
    "retentionDays": 7
  },
  "language": "auto"
}
