<Window x:Class="EmojiPick.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EmojiPick"
        Width="400" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E6222233"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="True"
        WindowStartupLocation="Manual">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CtxLabel" Grid.Row="0"
                   Foreground="White" FontSize="12"
                   MaxWidth="370" TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,6" />

        <UniformGrid x:Name="EmojiGrid" Grid.Row="1"
                     Rows="4" Columns="4"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBox x:Name="SearchBox" Grid.Row="2"
                 Background="#222233" Foreground="White"
                 Padding="8,6" FontSize="14"
                 BorderThickness="0"
                 Margin="0,6,0,0" />
    </Grid>
</Window>
