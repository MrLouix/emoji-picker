<Window x:Class="EmojiPick.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EmojiPick"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}">

    <!-- Plain, light settings dialog: standard WPF controls stay readable on it in every theme. -->
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F7FA" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#E1E3EA" />
        <SolidColorBrush x:Key="TextBrush" Color="#1C1D22" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B6F80" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6A55F5" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,16">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
            <TextBlock Text="✨" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Shortcut -->
        <TextBlock x:Name="ShortcutTitle" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HotkeyLabel" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ModCtrl" Content="Ctrl" Margin="0,6,14,6" />
                        <CheckBox x:Name="ModAlt" Content="Alt" Margin="0,6,14,6" />
                        <CheckBox x:Name="ModShift" Content="Shift" Margin="0,6,14,6" />
                        <CheckBox x:Name="ModWin" Content="Win" Margin="0,6,14,6" />
                    </StackPanel>
                    <!-- Read-only: the next key pressed here becomes the hotkey key -->
                    <TextBox x:Name="HotkeyKeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             FontWeight="SemiBold" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Appearance -->
        <TextBlock x:Name="AppearanceTitle" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ThemeLabel" Grid.Row="0" Style="{StaticResource Label}" />
                <ComboBox x:Name="ThemeBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" />

                <TextBlock x:Name="LanguageLabel" Grid.Row="1" Style="{StaticResource Label}" />
                <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />

                <TextBlock x:Name="SkinToneLabel" Grid.Row="2" Style="{StaticResource Label}" />
                <ComboBox x:Name="SkinToneBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />

                <CheckBox x:Name="ColorEmojiBox" Grid.Row="3" Grid.ColumnSpan="3" />

                <TextBlock x:Name="SizeLabel" Grid.Row="4" Style="{StaticResource Label}" />
                <Slider x:Name="SizeSlider" Grid.Row="4" Grid.Column="1" Minimum="14" Maximum="48" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Value, ElementName=SizeSlider}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />

                <TextBlock x:Name="ColumnsLabel" Grid.Row="5" Style="{StaticResource Label}" />
                <Slider x:Name="ColumnsSlider" Grid.Row="5" Grid.Column="1" Minimum="3" Maximum="12" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Value, ElementName=ColumnsSlider}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />

                <TextBlock x:Name="RowsLabel" Grid.Row="6" Style="{StaticResource Label}" />
                <Slider x:Name="RowsSlider" Grid.Row="6" Grid.Column="1" Minimum="1" Maximum="8" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Value, ElementName=RowsSlider}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>

        <!-- Behavior -->
        <TextBlock x:Name="BehaviorTitle" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PositionLabel" Grid.Row="0" Style="{StaticResource Label}" />
                <ComboBox x:Name="PositionBox" Grid.Row="0" Grid.Column="1" />

                <TextBlock x:Name="InjectLabel" Grid.Row="1" Style="{StaticResource Label}" />
                <ComboBox x:Name="InjectBox" Grid.Row="1" Grid.Column="1" />

                <!-- Checkboxes span both columns: their labels are long in French and do not wrap -->
                <CheckBox x:Name="RestoreClipboardBox" Grid.Row="2" Grid.ColumnSpan="2" />
                <CheckBox x:Name="AutoStartBox" Grid.Row="3" Grid.ColumnSpan="2" />
            </Grid>
        </Border>

        <!-- AI -->
        <TextBlock x:Name="AiTitle" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="AiEnabledBox" Grid.Row="0" Grid.ColumnSpan="2" />

                <TextBlock x:Name="EndpointLabel" Grid.Row="1" Style="{StaticResource Label}" />
                <TextBox x:Name="EndpointBox" Grid.Row="1" Grid.Column="1"
                         IsEnabled="{Binding IsChecked, ElementName=AiEnabledBox}" />

                <TextBlock x:Name="ModelLabel" Grid.Row="2" Style="{StaticResource Label}" />
                <TextBox x:Name="ModelBox" Grid.Row="2" Grid.Column="1"
                         IsEnabled="{Binding IsChecked, ElementName=AiEnabledBox}" />
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Margin="0,4,0,0">
            <TextBlock x:Name="OpenFileLink" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" Cursor="Hand" TextDecorations="Underline" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Style="{StaticResource DialogButton}" IsDefault="True" />
                <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
