<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="EmojiPick" Language="1033" Version="1.0.0" Manufacturer="EmojiPick" UpgradeCode="7F2A4B6C-8D1E-4F3A-9B5C-6E7D8F9A0B1C" InstallerVersion="500">

    <!-- Major Upgrade Support -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of EmojiPick is already installed." />

    <!-- Embed CAB -->
    <MediaTemplate EmbedCab="yes" />

    <!-- UI with license -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- App icon for Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Install directory: C:\Program Files\EmojiPick\ -->
    <Property Id="WIXUI_INSTALLDIR" Value="AppFolder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="EmojiPick">
        <Directory Id="AppFolder" />
      </Directory>
    </StandardDirectory>

    <!-- Main executable -->
    <DirectoryRef Id="AppFolder">
      <Component Id="MainExecutable" Guid="*">
        <File Source="$(var.ExeFile)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Feature -->
    <Feature Id="MainApplication" Title="EmojiPick" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Start Menu Shortcut -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
      <Shortcut Id="AppStartMenuShortcut" Name="EmojiPick" Description="Emoji Overlay Picker" Target="[AppFolder]EmojiPick.exe" WorkingDirectory="AppFolder" />
      <RegistryValue Root="HKCU" Key="Software\EmojiPick\StartMenu" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Desktop Shortcut -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="AppDesktopShortcut" Name="EmojiPick" Description="Emoji Overlay Picker" Target="[AppFolder]EmojiPick.exe" WorkingDirectory="AppFolder" />
      <RegistryValue Root="HKCU" Key="Software\EmojiPick\Desktop" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
