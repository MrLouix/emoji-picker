<Window x:Class="EmojiPick.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EmojiPick"
        Width="400" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#33000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context label (Phase 8) -->
        <TextBlock x:Name="CtxLabel" Grid.Row="0"
                   Text="Sélection: ..."
                   Foreground="White" FontSize="14" Margin="0,0,0,8" />

        <!-- Emoji grid (Phase 8) -->
        <UniformGrid x:Name="EmojiGrid" Grid.Row="1"
                     Rows="3" Columns="4"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Search box (Phase 8) -->
        <TextBox x:Name="SearchBox" Grid.Row="2"
                 Text="Rechercher..." Foreground="Gray"
                 Padding="6" Margin="0,4,0,4" />

        <!-- Action buttons (Phase 8) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnCopy" Content="Copier" Margin="0,0,8,0" />
            <Button x:Name="BtnPaste" Content="Paste" Margin="0,0,8,0" />
            <Button x:Name="BtnClose" Content="Fermer" />
        </StackPanel>
    </Grid>
</Window>
